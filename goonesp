-- UI Elemek Generálása
local function AddToggle(tabName, text, toggleKey)
    local parent = contentFrames[tabName]
    if not parent then return end

    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(18, 14, 25)
    btn.BorderColor3 = Color3.fromRGB(40, 30, 55)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. ": [OFF]"
    btn.TextColor3 = Color3.fromRGB(180, 170, 200)
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        getgenv().voidXToggles[toggleKey] = not getgenv().voidXToggles[toggleKey]
        local state = getgenv().voidXToggles[toggleKey]
        btn.Text = "  " .. text .. ": [" .. (state and "ON" or "OFF") .. "]"
        btn.TextColor3 = state and AccentColor or Color3.fromRGB(180, 170, 200)
        btn.BorderColor3 = state and AccentColor or Color3.fromRGB(40, 30, 55)
        Notify(text .. ": " .. (state and "ON" or "OFF"))
    end)
end

local function AddButtonOption(tabName, text, options, optionKey, callback)
    local parent = contentFrames[tabName]
    if not parent then return end

    local currentIndex = 1
    for i, v in ipairs(options) do
        if v == getgenv().voidXOptions[optionKey] then currentIndex = i end
    end

    local btn = Instance.new("TextButton")
    btn.Parent = parent
    btn.BackgroundColor3 = Color3.fromRGB(18, 14, 25)
    btn.BorderColor3 = Color3.fromRGB(40, 30, 55)
    btn.Size = UDim2.new(1, 0, 0, 35)
    btn.Font = Enum.Font.GothamMedium
    btn.Text = "  " .. text .. ": < " .. tostring(getgenv().voidXOptions[optionKey]) .. " >"
    btn.TextColor3 = AccentColor
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        currentIndex = currentIndex + 1
        if currentIndex > #options then currentIndex = 1 end
        local selectedVal = options[currentIndex]
        getgenv().voidXOptions[optionKey] = selectedVal
        btn.Text = "  " .. text .. ": < " .. tostring(selectedVal) .. " >"
        if callback then callback(selectedVal) end
    end)
end

