local function getClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = math.huge
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local localHRP = localChar.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                local isTeam = false
                if Toggles.TeamCheck and Toggles.TeamCheck.Value then
                    if player.Team == LocalPlayer.Team and player.Team ~= nil then
                        isTeam = true
                    end
                end
                
                if not isTeam then
                    local distance = (localHRP.Position - hrp.Position).Magnitude
                    local maxDist = Options.Distance and Options.Distance.Value or 500
                    
                    if distance < shortestDistance and distance <= maxDist then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    
    return closestPlayer
end

-- Ragebot: 10 studdal az ellenfél fölé teleportálás
RunService.RenderStepped:Connect(function()
    if Toggles.RageEnabled and Toggles.RageEnabled.Value then
        local target = getClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local enemyHRP = target.Character.HumanoidRootPart
            local localChar = LocalPlayer.Character
            if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                local targetCFrame = enemyHRP.CFrame + Vector3.new(0, 10, 0)
                localChar.HumanoidRootPart.CFrame = targetCFrame
            end
        end
    end
end)

-- Sticky Aim / Kamera Követés
RunService.RenderStepped:Connect(function()
    if Toggles.StickyAim and Toggles.StickyAim.Value then
        local target = getClosestPlayer()
        if target and target.Character then
            local hitPartName = Options.HitPart and Options.HitPart.Value or "Head"
            local part = target.Character:FindFirstChild(hitPartName) or target.Character:FindFirstChild("HumanoidRootPart")
            if part then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
            end
        end
    end
end)

-- Triggerbot
RunService.RenderStepped:Connect(function()
    if Toggles.TriggerBotEnabled and Toggles.TriggerBotEnabled.Value then
        local mouse = LocalPlayer:GetMouse()
        local targetPart = mouse.Target
        
        if targetPart and targetPart.Parent then
            local enemyPlayer = Players:GetPlayerFromCharacter(targetPart.Parent)
            if enemyPlayer and enemyPlayer ~= LocalPlayer then
                local isTeam = false
                if Toggles.TriggerTeamCheck and Toggles.TriggerTeamCheck.Value then
                    if enemyPlayer.Team == LocalPlayer.Team and enemyPlayer.Team ~= nil then
                        isTeam = true
                    end
                end
                
                if not isTeam then
                    if mouse1click then
                        mouse1click()
                    elseif pressmousebutton1 then
                        pressmousebutton1()
                    end
                end
            end
        end
    end
end)

-- Fekete Outline ESP
local function applyHighlight(char)
    if not char then return end
    if char:FindFirstChild("XenowareOutline") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "XenowareOutline"
    hl.Adornee = char
    hl.FillTransparency = 1
    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
    hl.OutlineTransparency = 0
    hl.Parent = char
end

task.spawn(function()
    while true do
        task.wait(1)
        if Toggles.PlayerOutline and Toggles.PlayerOutline.Value then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    applyHighlight(p.Character)
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hl = p.Character:FindFirstChild("XenowareOutline")
                    if hl then hl:Destroy() end
                end
            end
        end
    end
end)

-- Fly / Repülés
RunService.RenderStepped:Connect(function()
    if Toggles.FlyEnabled and Toggles.FlyEnabled.Value then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
            local hrp = char.HumanoidRootPart
            char.Humanoid.PlatformStand = true
            
            local moveDir = Vector3.new()
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
            
            local speed = Options.FlySpeed and Options.FlySpeed.Value or 50
            hrp.Velocity = moveDir * speed
        else
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                char.Humanoid.PlatformStand = false
            end
        end
    else
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
        end
    end
end)

