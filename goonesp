-- 3. TRIGGER BOT & HITBOX EXPANDER
-- ==============================================================================
RunService.RenderStepped:Connect(function()
    -- Hitbox Multipier alkalmazása
    local mul = Options.HitboxMul and Options.HitboxMul.Value or 1.00
    if mul > 1.00 then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(2 * mul, 2 * mul, 1 * mul)
                p.Character.HumanoidRootPart.Transparency = 0.7
                p.Character.HumanoidRootPart.CanCollide = false
            end
        end
    end

    -- Triggerbot logika
    if Toggles.TriggerEnabled and Toggles.TriggerEnabled.Value then
        local mouse = LocalPlayer:GetMouse()
        local targetPart = mouse.Target
        
        if targetPart and targetPart.Parent then
            local enemyPlayer = Players:GetPlayerFromCharacter(targetPart.Parent)
            if enemyPlayer and enemyPlayer ~= LocalPlayer then
                if not Toggles.TriggerTeamCheck.Value or enemyPlayer.Team ~= LocalPlayer.Team then
                    if mouse1click then
                        mouse1click()
                    elseif pressmousebutton1 then
                        pressmousebutton1()
                    end
                end
            end
        end
    end
end)

