                local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                if hrp and tool then
                    local toolName = tool.Name:lower()
                    if toolName:find("katana") or toolName:find("sword") or toolName:find("blade") or toolName:find("knife") then
                        local dist = (localHRP.Position - hrp.Position).Magnitude
                        if dist < 14 then
                            local escapeDir = (localHRP.Position - hrp.Position).Unit
                            localHRP.CFrame = localHRP.CFrame + (escapeDir * 18)
                        end
                    end
                end
            end
        end
    end)
end)

