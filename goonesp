-- ==============================================================================
-- 1. AIMBOT & BRUTÁLIS RAGEBOT LOGIKA
-- ==============================================================================
RunService.RenderStepped:Connect(function()
    if Toggles.Enabled and Toggles.Enabled.Value then
        local target = getBestTarget(true, Options.Distance and Options.Distance.Value or 500, Toggles.TeamCheck.Value, Toggles.VisibleCheck.Value)
        
        if target and target.Character then
            local hitPartName = Options.HitPart and Options.HitPart.Value or "Head"
            local part = target.Character:FindFirstChild(hitPartName) or target.Character:FindFirstChild("HumanoidRootPart")
            
            if part then
                local aimType = Options.AimType and Options.AimType.Value or "Camera"
                
                if aimType == "Camera" then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                elseif aimType == "Mouse" then
                    local screenPos = Camera:WorldToViewportPoint(part.Position)
                    mousemoverel((screenPos.X - UserInputService:GetMouseLocation().X) * 0.5, (screenPos.Y - UserInputService:GetMouseLocation().Y) * 0.5)
                elseif aimType == "Vector" then
                    -- Brutálisabb Ragebot mód: közvetlen pozíció igazítás / Lock
                    local localChar = LocalPlayer.Character
                    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
                        localChar.HumanoidRootPart.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                    end
                end
                
                if Toggles.StickyAim and Toggles.StickyAim.Value then
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
                end
            end
        end
    end
end)

-- ==============================================================================
-- 2. SILENT AIM (Metamethod Hook - Ha a Delta/Xeno támogatja)
-- ==============================================================================
pcall(function()
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod()
        
        if Toggles.SilentEnabled and Toggles.SilentEnabled.Value then
            if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "Raycast" then
                local target = getBestTarget(false, Options.SilentDistance and Options.SilentDistance.Value or 500, Toggles.SilentTeamCheck.Value, Toggles.SilentVisibleCheck.Value)
                if target and target.Character then
                    local hitPartName = Options.SilentHitPart and Options.SilentHitPart.Value or "Head"
                    local part = target.Character:FindFirstChild(hitPartName)
                    if part and method == "Raycast" then
                        args[2] = (part.Position - args[1]).Unit * 1000
                    end
                end
            end
        end
        return oldNamecall(self, unpack(args))
    end)
end)

