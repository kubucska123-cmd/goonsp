local Players = game:GetService("Players")

local function setupHighlight(character)
    if character:FindFirstChild("PlayerOutline") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "PlayerOutline"
    highlight.Adornee = character
    highlight.OutlineColor = Color3.fromRGB(0, 0, 0) -- Fekete körvonal
    highlight.OutlineTransparency = 0
    highlight.FillTransparency = 1 -- Csak a körvonal látszódjon, belső kitöltés nélkül
    highlight.Parent = character
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(setupHighlight)
    if player.Character then
        setupHighlight(player.Character)
    end
end)

for _, player in ipairs(Players.GetPlayers()) do
    if player.Character then
        setupHighlight(player.Character)
    end
end
