local function PlayHitSound()
    if not getgenv().voidXToggles.HitSoundsEnabled then return end
    pcall(function()
        local soundName = getgenv().voidXOptions.SelectedHitSound
        local soundId = SoundIDs[soundName] or SoundIDs["Neverlose"]
        local sound = Instance.new("Sound")
        sound.SoundId = soundId
        sound.Volume = 2
        sound.Parent = SoundService
        sound:Play()
        sound.Ended:Connect(function() sound:Destroy() end)
    end)
end

local function getBestTarget()
    local bestTarget = nil
    local shortestDist = math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local localChar = LocalPlayer.Character
    
    if not localChar or not localChar:FindFirstChild("HumanoidRootPart") then return nil end
    local localHRP = localChar.HumanoidRootPart

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChild("Humanoid")
            local hrp = player.Character:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and hrp then
                if getgenv().voidXToggles.TeamCheck and player.Team == LocalPlayer.Team and player.Team ~= nil then
                    continue
                end
                
                local dist = (localHRP.Position - hrp.Position).Magnitude
                if dist <= getgenv().voidXOptions.Distance then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                        if screenDist <= getgenv().voidXOptions.FOVRadius and screenDist < shortestDist then
                            shortestDist = screenDist
                            bestTarget = player
                        end
                    end
                end
            end
        end
    end
    return bestTarget
end

