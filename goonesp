local function applyHighlight(char)
    if not char then return end
    if char:FindFirstChild("XenowareOutline") then return end

    local hl = Instance.new("Highlight")
    hl.Name = "XenowareOutline"
    hl.Adornee = char
    hl.FillTransparency = 1
    hl.OutlineColor = Color3.fromRGB(0, 0, 0)
    hl.OutlineTransparency = 0
    hl.Parent = char
end

task.spawn(function()
    while true do
        task.wait(1)
        if Toggles.PlayerOutline and Toggles.PlayerOutline.Value then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    applyHighlight(p.Character)
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local hl = p.Character:FindFirstChild("XenowareOutline")
                    if hl then hl:Destroy() end
                end
            end
        end
    end
end)

